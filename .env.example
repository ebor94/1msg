# =====================================================================
# Configuración de la bandeja WhatsApp — Serfunorte
# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se versiona (está en .gitignore).
# =====================================================================

# --- Entorno de ejecución ---
NODE_ENV=development
PORT=3000

# --- Base de datos MySQL (serfuweb existente) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serfuweb
DB_USER=
DB_PASSWORD=
# Zona horaria de conexión MySQL (Colombia)
DB_TIMEZONE=-05:00

# --- API de 1msg (solo servidor, jamás llega al frontend) ---
ONEMSG_BASE_URL=https://api.1msg.io
ONEMSG_INSTANCE_ID=
ONEMSG_TOKEN=

# --- Webhook ---
# Secreto compartido que 1msg debe presentar; se valida en la ruta/header.
WEBHOOK_SECRET=

# --- Almacenamiento de medios ---
MEDIA_PATH=./media
# Tamaño máximo de media a descargar, en bytes (por defecto 50 MB)
MEDIA_MAX_BYTES=52428800

# --- Logging ---
# error | warn | info | http | debug
LOG_LEVEL=info
LOG_DIR=./logs

# --- Autenticación de la bandeja (Fase 2) ---
JWT_SECRET=
JWT_EXPIRES=12h
